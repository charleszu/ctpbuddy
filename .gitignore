# 构建产物
/target/
core/target/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/

# Shim 编译产物（DLL / obj / 导入库，由 shim/build_msvc.py 生成）
shim/bin/
shim/build/
shim/lib/
*.dll
*.lib
*.exp
*.pdb
*.obj

# 运行产物
logs/
*.jsonl

# PDF 逐页图像抽取的临时产物（阅读图像型 PDF 用，非交付物）
.tmp_pdfimg/

# 但随包参考数据（refdata/）是源码，必须入库：
# Catalog::bundled() 与 e2e 都直接读它，clone 不到 = 起步就没有合约。
!refdata/*.jsonl

# 官方 SDK：仅本地构建使用，禁止入库与分发
ctpsdk/*/

# 运行时数据（journal/db/log，默认 ./data）
data/

# 本地代理工作数据
.workbuddy/
