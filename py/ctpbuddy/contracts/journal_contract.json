{
  "contract_version": 1,
  "envelope": {
    "required": ["seq", "ts_wall", "trading_day", "vt_ms", "type", "data"],
    "optional": ["broker", "investor"],
    "data_type": "object_or_null",
    "canonical_omit": ["ts_wall"]
  },
  "events": {
    "server_start": {"category": "operational", "replay": "none", "hash": "noise", "projection": []},
    "server_stop": {"category": "operational", "replay": "none", "hash": "noise", "projection": []},
    "scenario_loaded": {"category": "operational", "replay": "reissue", "hash": "noise", "projection": ["audit_log"]},
    "session_auth": {"category": "session_input", "replay": "reissue", "hash": "semantic", "normalize": ["front_id_rank"], "projection": []},
    "session_login": {"category": "session_input", "replay": "reissue", "hash": "semantic", "normalize": ["front_id_rank"], "projection": []},
    "session_logout": {"category": "session_input", "replay": "reissue", "hash": "semantic", "projection": []},
    "order_insert": {"category": "trading_input", "replay": "reissue", "hash": "semantic", "projection": ["order_record"], "data_required": ["order_ref", "instrument", "exchange", "direction", "offset", "price_type", "limit_price", "volume", "time_condition", "volume_condition", "min_volume", "outcome"]},
    "order_cancel": {"category": "trading_input", "replay": "reissue", "hash": "semantic", "projection": [], "data_required": ["order_ref", "instrument", "submit_status", "outcome"]},
    "order_update": {"category": "trading_output", "replay": "none", "hash": "semantic", "projection": ["order_record"], "data_required": ["order_ref", "status"]},
    "fill": {"category": "trading_output", "replay": "none", "hash": "semantic", "projection": ["trade_record", "position_change"], "data_required": ["trade_id", "instrument", "direction", "offset", "price", "volume"]},
    "md_watermark": {"category": "operational", "replay": "reissue", "hash": "noise", "projection": [], "data_required": ["idx"]},
    "assertion": {"category": "scenario_output", "replay": "none", "hash": "semantic", "projection": ["account_snapshot"], "data_required": ["metric", "op", "value", "actual", "pass", "status", "after_ms"]},
    "reset_account": {"category": "admin_input", "replay": "reissue", "hash": "semantic", "projection": ["audit_log"]},
    "settlement": {"category": "admin_input", "replay": "reissue", "hash": "semantic", "projection": ["account_snapshot", "position_snapshot", "audit_log"]},
    "settlement_report": {"category": "admin_input", "replay": "reissue", "hash": "semantic", "projection": ["settlement_report", "audit_log"], "data_required": ["settlement_id", "account_id", "currency_id", "content_bytes"]},
    "settings_updated": {"category": "admin_input", "replay": "reissue", "hash": "semantic", "projection": ["audit_log"]},
    "deposit": {"category": "admin_input", "replay": "skip", "hash": "semantic", "projection": ["audit_log"]},
    "withdraw": {"category": "admin_input", "replay": "skip", "hash": "semantic", "projection": ["audit_log"]},
    "settle": {"category": "admin_input", "replay": "skip", "hash": "semantic", "projection": ["audit_log"]},
    "admin": {"category": "admin_input", "replay": "skip", "hash": "semantic", "projection": ["audit_log"]}
  }
}
