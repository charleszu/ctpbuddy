{
  "contract_version": 3,
  "read_versions": [1, 2, 3],
  "envelope": {
    "required": ["seq", "ts_wall", "trading_day", "vt_ms", "type", "data"],
    "optional": ["broker", "investor"],
    "data_type": "object_or_null",
    "canonical_omit": ["ts_wall"]
  },
  "events": {
    "server_start": {"category": "operational", "replay": "none", "hash": "noise", "projection": []},
    "server_stop": {"category": "operational", "replay": "none", "hash": "noise", "projection": []},
    "flow_input": {"min_version": 3, "category": "operational", "replay": "reissue", "hash": "noise", "projection": [], "data_required": ["action", "conn_id", "clock_ns"], "data_types": {"action": "string", "conn_id": "number", "clock_ns": "string"}},
    "flow_output": {"min_version": 3, "category": "operational", "replay": "none", "hash": "noise", "projection": [], "data_required": ["conn_id", "msg_type", "req_id", "error_id", "payload"], "data_types": {"conn_id": "number", "msg_type": "number", "req_id": "number", "error_id": "number_or_null", "payload": "string"}},
    "system_announcement": {"min_version": 2, "category": "operational", "replay": "reissue", "hash": "noise", "projection": ["audit_log"], "data_required": ["type", "severity", "message", "trading_day"], "data_types": {"type": "string", "severity": "string", "message": "string", "trading_day": "string"}},
    "ledger_recovered": {"category": "operational", "replay": "none", "hash": "noise", "projection": [], "data_required": ["trading_day", "working_orders_voided", "reason", "snapshot_journal_seq"], "data_types": {"trading_day": "string", "working_orders_voided": "boolean", "reason": "string", "snapshot_journal_seq": "number_or_null"}},
    "scenario_loaded": {"category": "operational", "replay": "reissue", "hash": "noise", "projection": ["audit_log"], "data_required": ["path", "name", "ticks", "paused", "speed", "transforms", "accounts", "bootstrap_positions", "assertions"], "data_types": {"path": "string", "name": "string", "ticks": "number", "paused": "boolean", "speed": "number", "transforms": "number", "accounts": "number", "bootstrap_positions": "number", "assertions": "number"}},
    "session_auth": {"category": "session_input", "replay": "reissue", "hash": "semantic", "normalize": ["front_id_rank"], "projection": [], "data_required": ["front_id", "app_id"], "data_types": {"front_id": "number", "app_id": "string"}},
    "session_login": {"category": "session_input", "replay": "reissue", "hash": "semantic", "normalize": ["front_id_rank"], "projection": [], "data_required": ["front_id", "session_id"], "data_types": {"front_id": "number", "session_id": "number"}},
    "session_logout": {"category": "session_input", "replay": "reissue", "hash": "semantic", "projection": []},
    "order_insert": {"category": "trading_input", "replay": "reissue", "hash": "semantic", "projection": ["order_record"], "data_required": ["order_ref", "instrument", "exchange", "direction", "offset", "price_type", "limit_price", "volume", "time_condition", "volume_condition", "min_volume", "outcome"], "data_types": {"order_ref": "string", "instrument": "string", "exchange": "string", "direction": "number", "offset": "number", "price_type": "string", "limit_price": "number", "volume": "number", "time_condition": "string", "volume_condition": "string", "min_volume": "number", "outcome": "object"}, "nested": {"outcome": {"required": ["accepted"], "types": {"accepted": "boolean", "error_id": "number", "msg": "string", "fills": "array"}, "items": {"fills": {"required": ["trade_id", "price", "volume"], "types": {"trade_id": "string", "price": "number", "volume": "number"}}}}}},
    "order_cancel": {"category": "trading_input", "replay": "reissue", "hash": "semantic", "projection": [], "data_required": ["order_ref", "instrument", "submit_status", "outcome"], "data_types": {"order_ref": "string", "instrument": "string", "submit_status": "string", "outcome": "object"}, "nested": {"outcome": {"required": ["accepted"], "types": {"accepted": "boolean", "error_id": "number", "msg": "string"}}}},
    "order_update": {"category": "trading_output", "replay": "none", "hash": "semantic", "projection": ["order_record"], "data_required": ["order_ref", "status"], "data_types": {"order_ref": "string", "status": "string"}},
    "fill": {"category": "trading_output", "replay": "none", "hash": "semantic", "projection": ["trade_record", "position_change"], "data_required": ["trade_id", "instrument", "direction", "offset", "price", "volume"], "data_types": {"trade_id": "string", "instrument": "string", "direction": "number", "offset": "number", "price": "number", "volume": "number"}},
    "md_watermark": {"category": "operational", "replay": "reissue", "hash": "noise", "projection": [], "data_required": ["idx"], "data_types": {"idx": "number"}},
    "assertion": {"category": "scenario_output", "replay": "none", "hash": "semantic", "projection": ["account_snapshot"], "data_required": ["metric", "op", "value", "actual", "pass", "status", "after_ms"], "data_types": {"metric": "string", "op": "string", "value": "number", "actual": "number_or_null", "pass": "boolean", "status": "string", "after_ms": "number"}},
    "reset_account": {"category": "admin_input", "replay": "reissue", "hash": "semantic", "projection": ["audit_log"], "data_required": ["all"], "data_types": {"all": "boolean"}},
    "settlement": {"category": "admin_input", "replay": "reissue", "hash": "semantic", "projection": ["account_snapshot", "position_snapshot", "audit_log"], "data_required": ["next_trading_day", "accounts"], "data_types": {"next_trading_day": "string", "accounts": "array"}},
    "settlement_report": {"category": "admin_input", "replay": "reissue", "hash": "semantic", "projection": ["settlement_report", "audit_log"], "data_required": ["settlement_id", "account_id", "currency_id", "content_bytes"], "data_types": {"settlement_id": "number", "account_id": "string", "currency_id": "string", "content_bytes": "array"}},
    "settings_updated": {"category": "admin_input", "replay": "reissue", "hash": "semantic", "projection": ["audit_log"], "data_required": ["after"], "data_types": {"after": "object"}},
    "deposit": {"category": "admin_input", "replay": "reissue", "hash": "semantic", "projection": ["audit_log"], "data_required": ["amount"], "data_types": {"amount": "number"}},
    "withdraw": {"category": "admin_input", "replay": "reissue", "hash": "semantic", "projection": ["audit_log"], "data_required": ["amount"], "data_types": {"amount": "number"}},
    "settle": {"category": "admin_input", "replay": "skip", "hash": "semantic", "projection": ["audit_log"], "data_policy": "opaque_object"},
    "admin": {"category": "admin_input", "replay": "skip", "hash": "semantic", "projection": ["audit_log"], "data_policy": "opaque_object"}
  }
}
